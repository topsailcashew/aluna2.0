# Firebase web app config — Project settings → Your apps → Web app → SDK setup.
# Copy this file to .env.local and fill in your own project's values.
#
# These keys are public by design: they identify the project, they do not grant
# access. Data is protected by the rules in firestore.rules.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: Firebase App Check via reCAPTCHA Enterprise. Leave unset and App
# Check stays inert. See SECURITY.md for the order to enable it in — turning
# enforcement on before clients send tokens locks everyone out.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Local development only, once App Check is enforced. Set to "true", then
# register the token the browser console prints under
# Firebase Console -> App Check -> Manage debug tokens.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
