rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------------------------------- */
    /* Private: everything a person logs about themselves                */
    /* ---------------------------------------------------------------- */

    match /users/{userId} {
      // The profile document: display name, avatar, preferences, key envelope.
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
                            && isValidProfile(request.resource.data);
      // Deletion is listed separately on purpose. `allow write` also covers
      // deletes, and on a delete `request.resource` is null — so validating it
      // rejected every deletion, leaving the profile and its key envelope
      // behind after someone had deleted their account.
      allow delete: if isOwner(userId);

      match /entries/{entryId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidEntry(request.resource.data);
        // Entries are a record of a moment; written once, never edited.
        allow update: if false;
      }

      // Free-form journal notes. Same encrypted shape as an entry, but these
      // are editable: a check-in records what was true at a moment, a piece of
      // writing is a draft until its author says otherwise.
      match /journal/{noteId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidNote(request.resource.data);
        allow update: if isOwner(userId)
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['payload', 'updatedAt'])
                      && request.resource.data.payload is string
                      && request.resource.data.payload.size() <= 400000;
      }

      // Private marker showing this person already added to a day's pulse.
      // The pulse write is gated on this existing, so once-a-day is enforced
      // server-side rather than on trust.
      match /contributions/{day} {
        allow read, write: if isOwner(userId);
      }

    }

    /* ---------------------------------------------------------------- */
    /* Shared: the community tab                                         */
    /* ---------------------------------------------------------------- */

    // One document per day holding a tally per emotion family. Anyone signed
    // in may read it and may add exactly one to exactly one family. The rules
    // cannot tell whether this person already counted today — a sibling write
    // in the same batch is invisible here — so once-a-day is enforced by the
    // client against the private marker above. Inflating a mood tally harms
    // nobody, and the alternative is a Cloud Function.
    // One document per day, a tally per emotion family. Adding to it requires
    // creating your own private contribution marker for that day in the SAME
    // write, and not already having one — so a person can move the pulse by at
    // most one, once a day, enforced by the rules rather than by trust.
    match /communityPulse/{day} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && isSingleTally(request.resource.data)
                    && claimsContribution(day);
      allow update: if isSignedIn()
                    && isSingleIncrement()
                    && claimsContribution(day);
      allow delete: if false;
    }

    // The wall. Posts carry NO author id — anonymity has to survive someone
    // querying the raw documents, not just the UI hiding a field. Ownership
    // lives in the author's private users/{uid}/reflections marker, written in
    // the same batch as the post and consulted only for deletion.
    match /reflections/{reflectionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && isValidReflection(request.resource.data)
                    && authoredHere(reflectionId);
      // Deletable only by whoever the (immutable) author record names.
      allow delete: if isSignedIn() && isAuthor(reflectionId);
      // The only permitted edit is the resonance tally, and only in step with
      // the caller's own acknowledgement — see isResonanceVote.
      allow update: if isSignedIn() && isResonanceVote(reflectionId);

      // One acknowledgement per person, keyed by uid so it cannot be doubled.
      match /resonances/{userId} {
        allow read: if isOwner(userId);
        allow create, delete: if isOwner(userId);
        allow update: if false;
      }
    }

    // Who authored each reflection. Readable ONLY by that author, so it deanon-
    // ymises nothing; create-once and immutable, so it cannot be hijacked to
    // seize a post. The public reflection carries no author id at all.
    match /reflectionAuthors/{reflectionId} {
      allow read: if isSignedIn() && resource.data.authorId == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(['authorId'])
                    && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }

    /* ---------------------------------------------------------------- */
    /* Helpers                                                           */
    /* ---------------------------------------------------------------- */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function families() {
      return ['happy', 'surprised', 'bad', 'fearful',
              'angry', 'disgusted', 'sad'];
    }

    // The key envelope lives here too. On its own it is two ciphertexts and
    // two salts: useless without the password or the recovery phrase, neither
    // of which ever reaches the server.
    function isValidProfile(data) {
      return data.keys().hasOnly([
               'displayName', 'avatarUrl', 'avatarColor',
               'shareToCommunity', 'reminderHour', 'onboardedAt',
               'keyEnvelope', 'updatedAt'
             ])
             && (!('keyEnvelope' in data) || isValidEnvelope(data.keyEnvelope))
             && (!('displayName' in data)
                 || (data.displayName is string && data.displayName.size() <= 60))
             // An avatar is a resized data URL held inline; the cap keeps the
             // document far below Firestore's 1 MiB limit.
             && (!('avatarUrl' in data)
                 || (data.avatarUrl is string && data.avatarUrl.size() <= 200000))
             && (!('avatarColor' in data)
                 || (data.avatarColor is string && data.avatarColor.size() <= 32))
             && (!('shareToCommunity' in data)
                 || data.shareToCommunity is bool)
             && (!('reminderHour' in data)
                 || data.reminderHour == null
                 || (data.reminderHour is int
                     && data.reminderHour >= 0
                     && data.reminderHour <= 23))
             && (!('onboardedAt' in data)
                 || data.onboardedAt == null
                 || (data.onboardedAt is string
                     && data.onboardedAt.size() <= 40));
    }

    function isValidEnvelope(envelope) {
      return envelope.keys().hasOnly([
               'v', 'passwordSalt', 'passwordWrapped',
               'phraseSalt', 'phraseWrapped', 'verifier'
             ])
             && envelope.v == 1
             && envelope.passwordWrapped is string
             && envelope.phraseWrapped is string
             && envelope.passwordWrapped.size() <= 4000
             && envelope.phraseWrapped.size() <= 4000;
    }

    // Shape check for a new entry.
    //
    // Entry content is now end-to-end encrypted, and this is what that costs:
    // `payload` is an opaque ciphertext, so the rules can no longer check that
    // emotions are non-empty, that a note is under 200 characters, or that
    // sensations are within their cap. Those limits are enforced by Zod in
    // src/lib/schemas.ts and nowhere else — a determined client can now write
    // a malformed entry, and only that client can read it back.
    //
    // What still holds server-side: ownership, append-only writes, an exact
    // field list, and a size ceiling that keeps a runaway payload from filling
    // the document. `createdAt` stays in the clear because Firestore has to
    // order and paginate on it; a timestamp alone reveals only that the app
    // was opened.
    function isValidEntry(data) {
      return data.keys().hasOnly(['v', 'payload', 'createdAt'])
             && data.v == 1
             && data.payload is string
             && data.payload.size() > 0
             // Generous next to a realistic entry, far below Firestore's 1 MiB.
             && data.payload.size() <= 200000
             // Forces serverTimestamp(): a client-chosen createdAt is refused.
             && data.createdAt == request.time;
    }

    // Journal notes run longer than check-ins, so the ceiling is higher --
    // still far below Firestore's 1 MiB per document.
    function isValidNote(data) {
      return data.keys().hasOnly(['v', 'payload', 'createdAt'])
             && data.v == 1
             && data.payload is string
             && data.payload.size() > 0
             && data.payload.size() <= 400000
             && data.createdAt == request.time;
    }

    function isValidReflection(data) {
      return data.keys().hasOnly([
               'text', 'primary', 'resonateCount', 'createdAt'
             ])
             && data.text is string
             && data.text.size() > 0
             && data.text.size() <= 240
             && (data.primary == null || data.primary in families())
             && data.resonateCount == 0
             && data.createdAt == request.time;
    }

    function authorDoc(reflectionId) {
      return /databases/$(database)/documents/reflectionAuthors/$(reflectionId);
    }

    // On create: the author record must be written in the same batch and name
    // the caller. On delete: the existing record must name the caller. Because
    // that record is create-once and immutable, it cannot be forged after the
    // fact to take over someone else's post.
    function authoredHere(reflectionId) {
      return existsAfter(authorDoc(reflectionId))
             && getAfter(authorDoc(reflectionId)).data.authorId == request.auth.uid;
    }

    function isAuthor(reflectionId) {
      return exists(authorDoc(reflectionId))
             && get(authorDoc(reflectionId)).data.authorId == request.auth.uid;
    }

    function myContribution(day) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/contributions/$(day);
    }

    // Adding to the pulse must create this person's marker for the day, and
    // they must not already have one. Bound to the same batch, so it cannot be
    // faked by writing the pulse alone.
    function claimsContribution(day) {
      return existsAfter(myContribution(day)) && !exists(myContribution(day));
    }

    // A brand-new day document may set a single family to exactly 1.
    function isSingleTally(data) {
      return data.keys().size() == 1
             && data.keys()[0] in families()
             && data[data.keys()[0]] == 1;
    }

    // Exactly one family moves up by exactly one. The previous version indexed
    // affectedKeys().toList()[0] — a rules Set has no toList(), so the whole
    // rule errored and EVERY increment was denied, legitimate ones included.
    // Enumerating the seven families avoids indexing a Set at all.
    function isSingleIncrement() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.size() == 1
             && changed.hasOnly(families())
             && familyUpByOne(changed);
    }

    function familyUpByOne(changed) {
      let d = request.resource.data;
      let p = resource.data;
      return (changed.hasAny(['happy'])     && d.happy     == p.get('happy', 0) + 1)
          || (changed.hasAny(['surprised']) && d.surprised == p.get('surprised', 0) + 1)
          || (changed.hasAny(['bad'])       && d.bad       == p.get('bad', 0) + 1)
          || (changed.hasAny(['fearful'])   && d.fearful   == p.get('fearful', 0) + 1)
          || (changed.hasAny(['angry'])     && d.angry     == p.get('angry', 0) + 1)
          || (changed.hasAny(['disgusted']) && d.disgusted == p.get('disgusted', 0) + 1)
          || (changed.hasAny(['sad'])       && d.sad       == p.get('sad', 0) + 1);
    }

    // Reflections are immutable apart from the resonance tally, and it may only
    // move in step with the caller's OWN acknowledgement marker: +1 while
    // creating your marker, -1 while removing it. One person can therefore
    // move any post's count by at most their single vote — no inflation, no
    // griefing a count down.
    function isResonanceVote(reflectionId) {
      let marker = /databases/$(database)/documents/reflections/$(reflectionId)/resonances/$(request.auth.uid);
      let before = resource.data.resonateCount;
      let after = request.resource.data.resonateCount;
      return request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['resonateCount'])
             && after is int
             && after >= 0
             && (
               (after == before + 1 && existsAfter(marker) && !exists(marker))
               || (after == before - 1 && !existsAfter(marker) && exists(marker))
             );
    }
  }
}
